{
  "name": "node-ts-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:debug": "NODE_OPTIONS='--inspect' tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Add ESLint later\"",
    "format": "echo \"Add Prettier later\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:name": "prisma migrate dev --name",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "echo \"Add tests later\"",
    "test:watch": "echo \"Add tests later\"",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "docker:build": "docker build -t ai-todo-backend .",
    "docker:run": "docker run -p 4000:4000 --env-file .env ai-todo-backend"
  },
  "dependencies": {
    "@clerk/express": "^1.7.46",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.2",
    "bullmq": "^5.66.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "ioredis": "^5.9.2",
    "openai": "^4.104.0",
    "pino": "^9.7.0",
    "pino-pretty": "^11.3.0",
    "socket.io": "^4.8.3",
    "svix": "^1.84.1",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.30",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.19.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
