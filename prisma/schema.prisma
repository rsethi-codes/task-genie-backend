// Enhanced Prisma schema for AI-Driven Task Management
generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================================
// ENUMS - Expanded for better type safety
// ============================================================================

enum UserRole {
  USER
  ADMIN
  OWNER
}

enum NodeStatus {
  DRAFT     // Idea, not yet committed
  ACTIVE    // Planned for execution
  BLOCKED   // Waiting on external factor
  COMPLETED // Done
  ARCHIVED  // Won't do / historical
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Visibility {
  private
  team
  public
}

enum Channel {
  push
  email
  sms
  webhook
}

enum QuestionType {
  text
  single_choice
  multiple_choice
  number
  date
  time
  duration
  scale
  boolean
}

enum SessionStatus {
  open
  completed
  abandoned
  interrupted
}

enum AttemptOutcome {
  completed
  paused
  abandoned
  failed
  interrupted
}

enum AIGenerationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum TaskEventType {
  CREATED
  STATUS_CHANGE
  CONTENT_EDIT
  AI_SYNC
  DELETED
  RESTORED
}

enum EventSource {
  UI
  AI_AGENT
  SYSTEM_JOB
  EXTERNAL_API
}

enum EnergyLevel {
  very_low
  low
  medium
  high
  very_high
}

enum FocusLevel {
  minimal
  light
  moderate
  deep
  intense
}

enum TimeOfDay {
  early_morning   // 5-8am
  morning         // 8-12pm
  afternoon       // 12-5pm
  evening         // 5-9pm
  night           // 9pm-12am
  late_night      // 12am-5am
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// ============================================================================
// CORE USER & PROFILE
// ============================================================================

model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId     String     @unique // Clerk integration
  email       String     @unique
  displayName String
  avatarUrl   String?
  timeZone    String     @default("UTC")
  locale      String     @default("en-US")
  roles       UserRole[] @default([USER])
  
  // System fields
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastSeenAt  DateTime?
  isActive    Boolean    @default(true)

  // Relations
  profile              UserProfile?
  taskNodes           TaskNode[]
  projectsOwned        Project[]              @relation("ProjectOwner")
  projectsMemberOf     ProjectMember[]
  comments             Comment[]
  reminders            Reminder[]
  auditLogs            AuditLog[]
  questionSessions     QuestionSession[]
  questionResponses    QuestionResponse[]
  embeddings           Embedding[]
  sharedTasks          TaskShare[]
  aiModelConfigs       AIModelConfig[]
  feedback             TaskFeedback[]
  webhooks             IntegrationWebhook[]
  refinementSessions   RefinementSession[]
  taskPatterns         TaskPattern[]
  behaviorPatterns     BehaviorPattern[]
  schedulePreferences  SchedulePreference[]
  currentPersonaVersion Int               @default(1)
  personaSnapshots      PersonaSnapshot[]

  @@index([email])
  @@index([clerkId])
  @@index([isActive])
}

model PersonaSnapshot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  version    Int
  traits     Json
  confidence Json
  meta       Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, version])
  @@index([userId, version(sort: Desc)])
}

// NEW: Separated user profile for better organization
model UserProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @db.Uuid
  
  // Preferences (structured, not JSON)
  defaultPriority     Priority     @default(MEDIUM)
  defaultDuration     Int?         // minutes
  workStartTime       String?      // "09:00"
  workEndTime         String?      // "17:00"
  preferredWorkDays   DayOfWeek[]
  breakDuration       Int?         // minutes
  
  // Behavioral metadata (limited JSON for truly variable data)
  customPreferences   Json?        // Theme, notifications, etc.
  integrations        Json?        // Connected apps
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NEW: AI-learned user persona (replaces preferences JSON)
model BehaviorPattern {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  
  // Pattern identification
  patternType        String          // "energy_by_time", "focus_by_day", "completion_by_priority"
  context            Json            // Conditions when this pattern applies
  
  // Pattern data
  confidence         Float           // 0-1, how reliable is this pattern
  sampleSize         Int             // How many data points
  lastObserved       DateTime
  
  // Energy patterns
  peakEnergyTime     TimeOfDay?
  lowEnergyTime      TimeOfDay?
  avgEnergyLevel     Float?          // 1-5
  
  // Focus patterns
  peakFocusTime      TimeOfDay?
  avgFocusDuration   Int?            // minutes
  bestFocusDays      DayOfWeek[]
  
  // Productivity patterns
  avgTasksPerDay     Float?
  avgCompletionRate  Float?          // 0-1
  procrastinationTendency Float?     // 0-1
  
  // Timing patterns
  planningToExecution Int?           // days between planning and doing
  estimationAccuracy  Float?         // actual/estimated ratio
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, patternType])
  @@index([confidence(sort: Desc)])
}

// NEW: User's schedule preferences and constraints
model SchedulePreference {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  
  // Time blocking
  dayOfWeek     DayOfWeek
  startTime     String        // "09:00"
  endTime       String        // "12:00"
  blockType     String        // "work", "personal", "blocked", "flexible"
  energyLevel   EnergyLevel?
  focusLevel    FocusLevel?
  
  // Constraints
  isRecurring   Boolean @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@index([userId, blockType])
}

// ============================================================================
// TASK NODES - Unified hierarchical system replacing Task/Subtask
// ============================================================================

enum NodeType {
  ROOT      // long-term goal
  PHASE     // multi-day / multi-week milestone  
  DAILY     // repeatable execution guidance
  ACTION    // one-off executable step
  GUIDANCE  // non-completable coaching insight
}

enum TemporalIntent {
  today     // Focus for today
  daily     // Repeats daily
  phase     // Part of current phase
  anytime   // No specific timing
}

model TaskNode {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @db.Uuid
  
  // Hierarchy
  parentId    String?    @db.Uuid  // null for ROOT nodes
  rootTaskId  String     @db.Uuid  // points to ROOT for all descendants
  
  // Basic fields
  title       String
  description String?
  nodeType    NodeType
  status      NodeStatus? @default(DRAFT)  // null for GUIDANCE nodes
  priority    Priority?   @default(MEDIUM)
  category    String?
  order       Int
  
  // Time & execution
  startDate            DateTime?
  dueDate              DateTime?
  estimatedDuration    Int?     // minutes per execution
  energyRequired       EnergyLevel?
  focusRequired        FocusLevel?
  recurrenceRule       String?  // iCal RRULE for DAILY nodes
  isRecurring          Boolean  @default(false)
  isCompletable        Boolean  @default(true)  // false for GUIDANCE nodes
  
  // Location & Context
  locationName         String?
  locationType         String?
  requiresInternet     Boolean  @default(false)
  requiresTools        String[]
  preferredTimeOfDay   TimeOfDay[]
  
  // AI metadata
  aiGenerated         Boolean @default(false)
  aiMetadata          Json?    // provider, feature, promptHash, reasoning, confidence
  
  // Progress tracking
  progressMeta        Json?    // contributesToProgress, weight
  actualDuration       Int      @default(0) // minutes
  lastStartedAt       DateTime?
  
  // Temporal intent
  temporalIntent       TemporalIntent @default(anytime)
  
  // System fields
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?
  
  // Correctness
  idempotencyKey      String?
  aiGenerationStatus  AIGenerationStatus @default(PENDING)

  // Relations
  user                User                @relation(fields: [userId], references: [id])
  parent              TaskNode?           @relation("NodeHierarchy", fields: [parentId], references: [id])
  children            TaskNode[]          @relation("NodeHierarchy")
  rootTask            TaskNode            @relation("RootTask", fields: [rootTaskId], references: [id])
  descendants         TaskNode[]          @relation("RootTask")
  
  // Legacy relations (for migration compatibility)
  projects            ProjectTask[]
  comments            Comment[]
  reminders           Reminder[]
  shares              TaskShare[]
  dependencies        TaskDependency[] @relation("Task")
  dependentOn         TaskDependency[] @relation("DependsOn")
  feedback            TaskFeedback[]
  refinementSession   RefinementSession?
  questionSessions    QuestionSession[]
  analytics           TaskAnalytics[]
  events              TaskEvent[]
  embeddings          Embedding[]
  patternFromNode     TaskPattern[]       @relation("PatternFromNode")
  basedOnPattern      TaskPattern?        @relation("NodeFromPattern")
  basedOnPatternId    String?             @db.Uuid

  @@unique([userId, idempotencyKey])
  @@index([userId, nodeType])
  @@index([userId, status])
  @@index([rootTaskId, order])
  @@index([parentId, order])
  @@index([temporalIntent])
  @@index([deletedAt])
}

// NEW: Time-series analytics for task nodes (queryable, not JSON)
model TaskAnalytics {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId String @db.Uuid
  
  // Snapshot at point in time
  recordedAt           DateTime @default(now())
  
  // Completion metrics
  completionRate       Float?   // 0-1
  onTimeCompletion     Boolean?
  daysToComplete       Int?
  daysOverdue          Int?
  
  // Effort metrics
  estimatedDuration    Int?
  actualDuration       Int?
  estimationAccuracy   Float?   // actual/estimated
  
  // Behavioral metrics
  attemptCount         Int @default(0)
  abandonmentCount     Int @default(0)
  pauseCount           Int @default(0)
  
  // AI metrics
  aiComplexityScore    Float?
  aiConfidence         Float?
  userSatisfaction     Int?     // 1-5 rating
  
  node TaskNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, recordedAt(sort: Desc)])
  @@index([recordedAt])
}

// NEW: Learned task patterns (AI learns from history)
model TaskPattern {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid
  
  // Pattern identification
  name              String
  category          String?
  keywords          String[]        // For matching
  
  // Pattern metrics
  occurrenceCount   Int @default(1)
  avgDuration       Int?            // minutes
  avgSubtaskCount   Int?
  successRate       Float?          // 0-1
  
  // Learned preferences
  bestTimeOfDay     TimeOfDay?
  bestDayOfWeek     DayOfWeek[]
  requiredEnergy    EnergyLevel?
  requiredFocus     FocusLevel?
  
  // Template data
  suggestedSubtasks Json[]          // Array of subtask templates
  suggestedSchedule Json?           // Scheduling hints
  
  // Pattern metadata
  confidence        Float           // 0-1
  lastUsed          DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodesUsingPattern TaskNode[] @relation("PatternFromNode")
  sourceNode        TaskNode?  @relation("NodeFromPattern", fields: [sourceNodeId], references: [id])
  sourceNodeId      String? @db.Uuid @unique

  @@index([userId, category])
  @@index([userId, confidence(sort: Desc)])
}

// ============================================================================
// QUESTION SESSIONS - Enhanced for behavioral analysis
// ============================================================================

model QuestionSession {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @db.Uuid
  nodeId        String?       @db.Uuid
  modelConfigId String?       @db.Uuid
  
  status        SessionStatus @default(open)
  ephemeral     Boolean       @default(false)
  
  // Session metadata
  totalQuestions    Int @default(0)
  answeredQuestions Int @default(0)
  skippedQuestions  Int @default(0)
  
  // Behavioral metrics (your insight!)
  avgResponseTime   Float?        // seconds
  totalSessionTime  Int?          // seconds
  hesitationCount   Int @default(0)
  revisedAnswers    Int @default(0)
  
  // AI decision
  decision          Json?         // Final AI plan
  decisionConfidence Float?
  
  // Onboarding specific
  exitReason        String?       // "completed", "skip", "timeout", "irrelevant"
  initialPersona    Boolean       @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?

  // Relations
  user      User               @relation(fields: [userId], references: [id])
  node      TaskNode?          @relation(fields: [nodeId], references: [id])
  responses QuestionResponse[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// NEW: Individual question responses (was JSON array)
model QuestionResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  userId    String   @db.Uuid
  
  // Question details
  questionId    String?  @db.Uuid  // Reference to Questionnaire if from template
  questionText  String
  questionType  QuestionType
  
  // Response
  answer        Json              // Actual answer value
  answerText    String?           // Human-readable version
  confidence    Int?              // 1-5 how confident user was
  
  // Behavioral tracking (YOUR BRILLIANT INSIGHT)
  responseTime  Int               // Milliseconds to answer
  hesitated     Boolean @default(false) // Took unusually long
  revised       Boolean @default(false) // Changed answer
  revisionCount Int @default(0)
  thoughtTime   Int?              // Time before typing started
  
  // Context
  answeredAt    DateTime
  order         Int               // Question order in session
  
  session       QuestionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id])

  @@index([sessionId, order])
  @@index([userId, answeredAt(sort: Desc)])
  @@index([hesitated])
}

model Questionnaire {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  String
  question  String
  type      QuestionType @default(text)
  options   String[]
  
  // AI hints
  aiHint          String?
  aiImportance    Float @default(0.5) // 0-1
  
  // Conditional logic
  conditionalOn   String? @db.Uuid    // Show if this question answered certain way
  conditionalValue Json?
  
  // Metadata
  isActive    Boolean @default(true)
  order       Int?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, order])
  @@index([isActive])
}

// ============================================================================
// EMBEDDINGS - Optimized for pgvector
// ============================================================================

model Embedding {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String   @db.Uuid
  
  // Document reference
  docType      String              // "taskNode", "pattern"
  docId        String   @db.Uuid
  
  // Vector (use pgvector extension)
  vector       Unsupported("vector(1536)")? // OpenAI ada-002 dimension
  
  // Metadata
  modelVersion String   @default("text-embedding-ada-002")
  dimensions   Int      @default(1536)
  content      String?  // Original text that was embedded
  
  createdAt    DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  taskNode TaskNode? @relation(fields: [docId], references: [id])

  @@index([ownerId, docType])
  @@index([docId])
  // Note: Add vector index manually: CREATE INDEX ON embeddings USING ivfflat (vector vector_cosine_ops);
}

// ============================================================================
// COLLABORATION
// ============================================================================

model Project {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  ownerId     String     @db.Uuid
  visibility  Visibility @default(private)
  color       String?
  
  // Project metadata
  isArchived  Boolean @default(false)
  startDate   DateTime?
  endDate     DateTime?
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner   User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members ProjectMember[]
  tasks   ProjectTask[]

  @@index([ownerId, isArchived])
  @@index([name])
}

model ProjectMember {
  projectId String     @db.Uuid
  userId    String     @db.Uuid
  role      String     @default("member") // "admin", "member", "viewer"
  joinedAt  DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
  @@index([userId])
}

model ProjectTask {
  projectId String @db.Uuid
  nodeId    String @db.Uuid
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node    TaskNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([projectId, nodeId])
  @@index([projectId])
}

model Comment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId    String    @db.Uuid
  authorId  String    @db.Uuid
  content   String
  mentions  String[]  @db.Uuid
  
  isEdited  Boolean   @default(false)
  isDeleted Boolean   @default(false)
  
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  node   TaskNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author User      @relation(fields: [authorId], references: [id])

  @@index([nodeId, createdAt(sort: Desc)])
  @@index([authorId])
}

model TaskShare {
  nodeId     String   @db.Uuid
  userId     String   @db.Uuid
  permission String   @default("view") // "view", "comment", "edit"
  sharedAt   DateTime @default(now())
  sharedBy   String?  @db.Uuid

  node TaskNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@id([nodeId, userId])
  @@index([userId])
}

// ============================================================================
// REMINDERS & NOTIFICATIONS
// ============================================================================

model Reminder {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @db.Uuid
  nodeId      String?   @db.Uuid
  
  triggerAt   DateTime
  channel     Channel   @default(push)
  message     String?
  payload     Json?
  
  delivered   Boolean   @default(false)
  deliveredAt DateTime?
  failedAt    DateTime?
  retryCount  Int       @default(0)
  
  createdAt   DateTime  @default(now())

  user User      @relation(fields: [userId], references: [id])
  node TaskNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, triggerAt])
  @@index([delivered, triggerAt])
}

// ============================================================================
// TAGS & METADATA
// ============================================================================

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  color     String?
  ownerId   String?  @db.Uuid
  isGlobal  Boolean  @default(false)
  usageCount Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([name, ownerId])
  @@index([isGlobal, name])
  @@index([ownerId, usageCount(sort: Desc)])
}

// ============================================================================
// AI INFRASTRUCTURE
// ============================================================================

model AIModelConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  provider         String   // "openai", "anthropic", "custom"
  modelId          String
  
  // Model parameters
  temperature      Float    @default(0.2)
  maxTokens        Int      @default(1000)
  topP             Float?
  frequencyPenalty Float?
  presencePenalty  Float?
  
  // Usage context
  purpose          String?  // "planning", "questioning", "analysis"
  promptTemplate   String?
  systemPrompt     String?
  
  // Ownership
  ownerId          String?  @db.Uuid
  isGlobal         Boolean  @default(false)
  isActive         Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id])

  @@index([isGlobal, isActive])
  @@index([ownerId])
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  action      String   // "created", "updated", "deleted", "ai_modified"
  performedBy String   @db.Uuid
  
  before      Json?
  after       Json?
  
  // Context
  ipAddress   String?
  userAgent   String?
  meta        Json?
  
  createdAt   DateTime @default(now())

  user User @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model TaskEvent {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId        String        @db.Uuid
  userId        String        @db.Uuid
  eventType     TaskEventType
  source        EventSource   @default(UI)
  
  // Data
  before        Json?
  after         Json?
  metadata      Json?         // context: { energyLevel, location, device }
  
  // Observability
  correlationId String?
  
  createdAt     DateTime      @default(now())

  node          TaskNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// NEW IMPROVEMENTS (TASK DEPENDENCIES, AI TRACKING, FEEDBACK, WEBHOOKS)
// ============================================================================

model TaskDependency {
  nodeId      String @db.Uuid
  dependsOnId String @db.Uuid
  type        String // "blocks", "relates_to", "parent_of"

  node      TaskNode @relation("Task", fields: [nodeId], references: [id])
  dependsOn TaskNode @relation("DependsOn", fields: [dependsOnId], references: [id])

  @@id([nodeId, dependsOnId])
}

model AIDecision {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId    String   @db.Uuid
  decisionType String // "breakdown", "schedule", "estimate"
  reasoning    String
  confidence   Float
  accepted     Boolean?
  metadata     Json?

  createdAt DateTime @default(now())
}

model TaskFeedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String   @db.Uuid
  userId      String   @db.Uuid
  rating      Int // 1-5
  whatWorked  String?
  whatDidnt   String?
  wouldChange String?
  submittedAt DateTime @default(now())

  node TaskNode @relation(fields: [nodeId], references: [id])
  user User      @relation(fields: [userId], references: [id])

  @@unique([nodeId, userId])
}

model IntegrationWebhook {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @db.Uuid
  service  String // "calendar", "slack", "notion"
  event    String // "task_completed", "deadline_approaching"
  url      String
  secret   String
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

model RefinementSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId          String   @db.Uuid @unique
  userId          String   @db.Uuid
  
  // Storage for comparison
  originalPlan    Json?    // AI's initial suggestion (subtasks, estimates)
  finalPlan       Json?    // Final version chosen by user
  comparisonStats Json?    // Pre-calculated stats for AI vs User
  
  status          String   @default("active") // active, finalized, discarded
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  node     TaskNode            @relation(fields: [nodeId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  messages RefinementMessage[]
}

model RefinementMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @db.Uuid
  role      String   // user, assistant, system
  content   String
  metadata  Json?    // Proposed changes or delta

  createdAt DateTime @default(now())

  session RefinementSession @relation(fields: [sessionId], references: [id])
}